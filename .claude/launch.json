{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 8140,
      "autoPort": true
    },
    {
      "name": "web-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8155", "--directory", "web/out"],
      "port": 8155
    },
    {
      "name": "cards",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8777", "--directory", "/tmp/cardgen"],
      "port": 8777
    }
  ]
}
